{
	"$schema": "https://unpkg.com/wrangler/config-schema.json",
	"name": "fakan-web",
	"main": "src/worker.js",
	"compatibility_date": "2026-05-14",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"html_handling": "auto-trailing-slash",
		"run_worker_first": ["/", "/osobni", "/osobni/*", "/feed.json", "/m/*", "/n/*", "/p/*", "/pustit/*", "/spravce",
			"/podklady/dan-hromada-cv.pdf", "/podklady/dan-hromada-reference.pdf", "/podklady/dan-hromada.vcf"]
	},
	// Média osobního feedu (9GAG archiv) leží v bucketu aplikace just post
	// pod posts/imported/. Worker je jen čte. "remote" = i wrangler dev čte ostrý bucket.
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "justpost-media",
			"remote": true
		},
		{ "binding": "FEED", "bucket_name": "fakan-feed" }
	],
	// Zámek a vlastní feed: lidé, příspěvky a hlasy v D1 (schéma v migrations/),
	// média nových příspěvků v R2 fakan-feed. Secrets: PODPIS_KLIC (podpis cookies),
	// SPRAVCE_KLIC (Danovo heslo pro schvalování).
	// Oznámení o žádosti Danovi (adresát z secretu PRESMEROVAT_NA, musí být ověřený v Email Routing)
	"send_email": [{ "name": "OZNAMENI" }],
	"d1_databases": [{ "binding": "DB", "database_name": "fakan-feed", "database_id": "00f73615-f963-4475-bbf9-00b086ebffed" }],
	// fakan.cz převzal tento Worker od fakan-cz (mindmapa běží dál na mindmap.fakan.cz)
	"routes": [{ "pattern": "fakan.cz", "custom_domain": true }],
	"observability": {
		"enabled": true
	}
}
